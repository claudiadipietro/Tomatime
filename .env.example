# Copy this file to .env and provide your own values. Do not commit .env.
# Use a randomly generated hexadecimal value for each of these.
POSTGRES_PASSWORD=
JWT_KEY=

# Optional: change if port 8080 is already in use.
APP_PORT=8080

# Optional: without these, password reset emails cannot be delivered.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional: without these, push notifications cannot be enabled.
# Keep the same key pair between restarts.
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
WEBPUSH_SUBJECT=
